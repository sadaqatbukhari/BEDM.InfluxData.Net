        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>InfluxData.Net is a fast, portable .NET library to access the REST API of an InfluxDB database and Kapacitor processing tool.

The library targets .NET 10.</description>
        <releaseNotes>For a full list of changes, please see CHANGELOG:
https://github.com/pootzko/InfluxData.Net/blob/master/CHANGELOG.md</releaseNotes>
        <tags>influx, influxdb, influxdata, kapacitor, TICK-stack</tags>
        <dependencies>
            <group targetFramework="net10.0">
                <dependency id="Newtonsoft.Json" version="13.0.4" />
            </group>
        </dependencies>
    </metadata>
