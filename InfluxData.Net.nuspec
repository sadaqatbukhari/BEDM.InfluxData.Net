<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
    <metadata>
        <id>InfluxData.Net.Latest</id>
        <version>$version$</version>
        <title>InfluxData.Net Latest</title>
        <authors>Sadaqat Hussain</authors>
        <owners>Sadaqat Hussain</owners>
        <license type="expression">MIT</license>
        <projectUrl>https://github.com/sadaqatbukhari/BEDM.InfluxData.Net</projectUrl>
        <repository type="git" url="https://github.com/sadaqatbukhari/BEDM.InfluxData.Net.git" />
        <icon>nuget-icon.png</icon>
        <readme>README.md</readme>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>A modernized .NET 10 client library for the InfluxDB and Kapacitor REST APIs, based on InfluxData.Net.

Includes backward-compatible InfluxQL operations, the InfluxDB 1.8+ v2-compatible delete API, and Flux querying through the official InfluxDB.Client.</description>
        <releaseNotes>Version $version$ targets .NET 10, modernizes dependencies and tests, and adds the InfluxDB 1.8+ delete and official Flux query APIs.</releaseNotes>
        <tags>influx influxdb influxdata flux kapacitor TICK-stack dotnet10</tags>
        <dependencies>
            <group targetFramework="net10.0">
                <dependency id="InfluxDB.Client" version="5.1.0" />
                <dependency id="Newtonsoft.Json" version="13.0.4" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.Common.dll" target="lib\net10.0\InfluxData.Net.Common.dll" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.Common.pdb" target="lib\net10.0\InfluxData.Net.Common.pdb" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.dll" target="lib\net10.0\InfluxData.Net.dll" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.InfluxDb.dll" target="lib\net10.0\InfluxData.Net.InfluxDb.dll" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.InfluxDb.pdb" target="lib\net10.0\InfluxData.Net.InfluxDb.pdb" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.Kapacitor.dll" target="lib\net10.0\InfluxData.Net.Kapacitor.dll" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.Kapacitor.pdb" target="lib\net10.0\InfluxData.Net.Kapacitor.pdb" />
        <file src="InfluxData.Net\bin\Release\net10.0\InfluxData.Net.pdb" target="lib\net10.0\InfluxData.Net.pdb" />
        <file src="README.md" target="README.md" />
        <file src="nuget-icon.png" target="nuget-icon.png" />
    </files>
</package>
